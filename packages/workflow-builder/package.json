{
  "name": "workflow-builder",
  "version": "1.0.0",
  "description": "Controlled node-based workflow editor for Circus Portraits",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --minify",
    "build": "npm run build:css && babel src --out-dir dist --extensions .js,.jsx",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "reactflow": "^11.11.4"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "autoprefixer": "^10.4.14",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.3",
    "vitest": "^5.0.0"
  }
}
